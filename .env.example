# Futbol Yapay Zekası - Ortam Değişkenleri (.env)
# ⚠️ Bu dosyayı kopyalayıp ".env" ismiyle kaydedin ve kendi API anahtarlarınızı girin.
# ⚠️ ".env" dosyası .gitignore tarafından korunur ve GitHub'a YÜKLENMEZ.

# 1. Football-Data.org API Key (Maç sonuçları ve puan durumu için)
# Ücretsiz Kayıt: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY="BURAYA_FOOTBALL_DATA_API_KEY_GIRIN"

# 2. The-Odds-API Key (Canlı oranlar ve Pinnacle verisi için - En Kritik)
# Ücretsiz Kayıt (500 istek/ay): https://the-odds-api.com/
ODDS_API_KEY="BURAYA_ODDS_API_KEY_GIRIN"

# 3. API-Football / Sports-API Key (Yedek oran ve istatistik servisi)
# Ücretsiz Kayıt (100 istek/gün): https://www.api-football.com/
API_FOOTBALL_KEY="BURAYA_API_FOOTBALL_KEY_GIRIN"

# 4. Sportmonks API Key (Opsiyonel gelişmiş veri servisi)
SPORTMONKS_API_KEY=""

# 5. Telegram Bildirim Botu (Opsiyonel)
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# 6. Başlangıç Kasa / Bankroll (TL veya Birim)
BANKROLL=5000
